# DATABASE CONFIGURATION
DATABASE_URL=postgresql://username:password@localhost:5432/skillconnect_db

# GOOGLE GEMINI API KEY (For AI Career Coach, resume analysis, mock interviews, etc.)
GEMINI_API_KEY=your_gemini_api_key_here

# CLERK AUTHENTICATION (Authentication credentials from clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_...
